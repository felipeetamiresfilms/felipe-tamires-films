# Felipe & Tamires Films — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# .env.local é ignorado pelo Git. NUNCA commite chaves reais.
#
# Onde encontrar: painel do Supabase > Project Settings > API
# https://supabase.com/dashboard/project/_/settings/api

# URL do projeto ("Project URL"). Pode ir para o browser.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" ("Project API keys" > anon public).
# Segura para o browser; o acesso é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" ("Project API keys" > service_role).
# SEGREDO ABSOLUTO: ignora o RLS, dá acesso total ao banco.
# Só é lida em código server-only (src/lib/supabase/server.ts).
# Nunca use o prefixo NEXT_PUBLIC_ aqui. Nunca logue este valor.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública canônica do site (com https://, SEM barra final, SEM www).
# Usada em metadata, canonical, Open Graph, sitemap, robots e dados
# estruturados (JSON-LD).
# Em produção, defina exatamente: https://felipeetamiresfilms.com.br
# Sem isso, cai para a URL do deploy (Netlify) e, no dev, localhost.
NEXT_PUBLIC_SITE_URL=

# ─── Analytics (opcional; Etapa 2) ────────────────────────────────────────
# Chave-mestra. Sem "true", NADA de GTM/GA4/Clarity é carregado, mesmo com
# consentimento. Mantenha desligado em previews/dev e em produção até a
# política de privacidade ser finalizada e aprovada.
NEXT_PUBLIC_ANALYTICS_ENABLED=
# Google Tag Manager (gerencia o GA4) — ex.: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# GA4 — usado no código só para o interruptor `ga-disable-<ID>` ao retirar
# o consentimento. A tag do GA4 vive no GTM, não no código. Ex.: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity — ID do projeto (carregado pelo app, nunca pelo GTM).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── Inteligência (Backstage) — Google Analytics Data API ────────────────
# SOMENTE servidor (sem NEXT_PUBLIC_). Guia: docs/inteligencia-ga4.md
# Opcional: o ID numérico da propriedade (558916123) já é o padrão no código.
# Só preencha para apontar para outra propriedade. NÃO é o ID de medição "G-…".
GA4_PROPERTY_ID=
# E-mail da conta de serviço do Google Cloud (…@….iam.gserviceaccount.com).
GA4_CLIENT_EMAIL=
# Chave privada da conta de serviço, entre aspas, com "\n" nas quebras:
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GA4_PRIVATE_KEY=
